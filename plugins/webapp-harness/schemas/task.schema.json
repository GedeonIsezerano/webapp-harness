{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_key",
    "title",
    "description",
    "priority",
    "dependencies",
    "gap_evidence",
    "acceptance_criteria",
    "verification",
    "scope"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "proposal_key": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "legacy_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "priority": {"type": "integer"},
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "type": {
      "enum": ["user-facing", "backend", "infrastructure", "documentation"]
    },
    "gap_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["location", "observation"],
        "properties": {
          "location": {"type": "string", "minLength": 1},
          "observation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "verification"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["unit", "integration", "command", "build", "e2e", "browser", "visual", "manual-review"]
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["profiles", "requires_browser"],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "requires_browser": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["recommended_paths", "forbidden_paths"],
      "properties": {
        "recommended_paths": {"$ref": "#/$defs/pathGuidance"},
        "forbidden_paths": {"$ref": "#/$defs/pathGuidance"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "pathGuidance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
