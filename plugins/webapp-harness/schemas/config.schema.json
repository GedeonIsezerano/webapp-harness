{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "type": "object",
  "required": ["schema_version", "retry_limits", "verification_profiles", "commit"],
  "properties": {
    "schema_version": {"const": 2},
    "retry_limits": {
      "type": "object",
      "required": ["verification", "review", "browser"],
      "properties": {
        "verification": {"type": "integer", "minimum": 0},
        "review": {"type": "integer", "minimum": 0},
        "browser": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "verification_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name", "command"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"}
            }
          },
          "additionalProperties": false
        }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "start_command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "health_url": {"type": "string", "format": "uri"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "browser": {
      "type": "object",
      "properties": {
        "playbook_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "fixture_notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "profile_notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "required": ["subject_format"],
      "properties": {
        "subject_format": {
          "type": "string",
          "minLength": 1,
          "description": "Supports {issue_number} and {title}."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
