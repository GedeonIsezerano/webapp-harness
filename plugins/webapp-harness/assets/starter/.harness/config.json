{
  "schema_version": 1,
  "retry_limits": {
    "verification": 3,
    "browser": 2,
    "review": 2
  },
  "repository": {
    "allowed_dirty_paths": [
      ".harness/"
    ]
  },
  "browser_validation": {
    "credentials_file": ".harness/dev-credentials.local.json"
  },
  "verification_profiles": {},
  "commit": {
    "required": true,
    "subject_format": "{task_id}: {title}"
  }
}
