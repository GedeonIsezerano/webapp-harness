{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "environment",
    "accounts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment": {
      "const": "development"
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "sign_in_url",
          "credentials"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "sign_in_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "minLength": 1
          },
          "credentials": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
