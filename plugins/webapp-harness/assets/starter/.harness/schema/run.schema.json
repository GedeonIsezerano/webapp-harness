{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "attempt",
    "status",
    "started_at",
    "base_commit",
    "event_counter",
    "transitions",
    "results",
    "stop_reason"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "implementing",
        "verifying",
        "reviewing",
        "browser_validating",
        "completed",
        "blocked",
        "cancelled",
        "superseded"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_counter": {
      "type": "integer",
      "minimum": 0
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "results": {
      "type": "object",
      "required": [
        "implementation",
        "verification",
        "review",
        "browser_validation"
      ],
      "properties": {
        "implementation": {
          "$ref": "#/$defs/resultEntries"
        },
        "verification": {
          "$ref": "#/$defs/resultEntries"
        },
        "review": {
          "$ref": "#/$defs/resultEntries"
        },
        "browser_validation": {
          "$ref": "#/$defs/resultEntries"
        }
      },
      "additionalProperties": false
    },
    "result_commit": {
      "type": [
        "string",
        "null"
      ],
      "deprecated": true,
      "description": "Legacy only. v0.0.10 resolves the task commit from its Run trailer."
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "type": "string"
    },
    "committed_at": {
      "type": "string",
      "deprecated": true
    },
    "diff_snapshot": {
      "type": "object",
      "required": [
        "path",
        "collected_at",
        "after_event_sequence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "collected_at": {
          "type": "string"
        },
        "after_event_sequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "resultEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "recorded_at",
          "result"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "recorded_at": {
            "type": "string"
          },
          "result": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
