{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "run_id",
    "status",
    "tooling",
    "criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASSED",
        "FAILED",
        "INCOMPLETE"
      ]
    },
    "tooling": {
      "type": "object",
      "description": "The browser-control surface actually used, from the cascade: browser_use skill, Chrome control (DevTools MCP or extension), computer_use MCP, or Playwright.",
      "required": [
        "surface"
      ],
      "properties": {
        "surface": {
          "enum": [
            "browser_use",
            "chrome_control",
            "computer_use",
            "playwright",
            "other"
          ]
        },
        "detail": {
          "type": "string",
          "description": "Version, profile, or setup detail for the chosen surface."
        }
      },
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "result",
          "steps",
          "observed",
          "expected",
          "url",
          "console_errors",
          "network_errors",
          "screenshots"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_VERIFIED"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "observed": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "console_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "network_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "screenshots": {
            "type": "array",
            "description": "Repository-relative paths of screenshots captured during this criterion, saved under .harness/runs/<run-id>/evidence/. At least one is required.",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
