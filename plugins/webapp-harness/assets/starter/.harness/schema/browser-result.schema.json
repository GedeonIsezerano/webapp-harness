{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "run_id",
    "status",
    "failure_class",
    "blocker",
    "preflight",
    "tooling",
    "criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASSED",
        "FAILED",
        "INCOMPLETE"
      ]
    },
    "failure_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "product",
        "fixture",
        "profile",
        "tooling",
        "environment",
        "scope",
        null
      ],
      "description": "Classify why a non-passing attempt stopped. Only product failures consume browser retry budget."
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ],
      "description": "Exact non-passing prerequisite or observed product failure; null only for PASSED."
    },
    "preflight": {
      "type": "object",
      "required": [
        "app_healthy",
        "fixtures_ready",
        "profiles_ready",
        "tooling_ready"
      ],
      "properties": {
        "app_healthy": {
          "type": "boolean"
        },
        "fixtures_ready": {
          "type": "boolean"
        },
        "profiles_ready": {
          "type": "boolean"
        },
        "tooling_ready": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "tooling": {
      "type": "object",
      "description": "The browser-control surface actually used, from the cascade: browser_use skill, Chrome control (DevTools MCP or extension), computer_use MCP, or Playwright.",
      "required": [
        "surface"
      ],
      "properties": {
        "surface": {
          "enum": [
            "browser_use",
            "chrome_control",
            "computer_use",
            "playwright",
            "other"
          ]
        },
        "detail": {
          "type": "string",
          "description": "Version, profile, or setup detail for the chosen surface."
        }
      },
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "result",
          "steps",
          "observed",
          "expected",
          "url",
          "console_errors",
          "network_errors",
          "screenshots"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_VERIFIED"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "observed": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "console_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "network_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "screenshots": {
            "type": "array",
            "description": "Repository-relative screenshots under the active run. The same screenshot may support several criteria when it visibly proves each one.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
