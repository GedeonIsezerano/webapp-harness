{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "generated_at",
    "criteria",
    "execution_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "description",
          "verification_kinds"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "verification_kinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "execution_policy": {
      "type": "object",
      "required": [
        "group_criteria_into_minimal_journeys",
        "shared_screenshots_allowed",
        "fresh_console_and_network_required",
        "persisted_state_required"
      ],
      "properties": {
        "group_criteria_into_minimal_journeys": {
          "const": true
        },
        "shared_screenshots_allowed": {
          "const": true
        },
        "fresh_console_and_network_required": {
          "const": true
        },
        "persisted_state_required": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
