{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "retry_limits",
    "verification_profiles",
    "commit"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "retry_limits": {
      "type": "object",
      "required": [
        "verification",
        "browser",
        "review"
      ],
      "properties": {
        "verification": {
          "type": "integer",
          "minimum": 0
        },
        "browser": {
          "type": "integer",
          "minimum": 0
        },
        "review": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "verification_profiles": {
      "type": "object"
    },
    "app": {
      "type": "object",
      "description": "How to run and health-check the application under test. Browser validation depends on it.",
      "properties": {
        "start_command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Argument array that starts the dev server, e.g. [\"npm\", \"run\", \"dev\"]."
        },
        "health_url": {
          "type": "string",
          "description": "URL that responds when the app is up, e.g. http://localhost:3000."
        },
        "notes": {
          "type": "string",
          "description": "Environment, ports, or test-account notes validators need."
        }
      },
      "additionalProperties": false
    },
    "browser": {
      "type": "object",
      "description": "Optional reusable setup that avoids rediscovering routes, fixtures, and role profiles.",
      "properties": {
        "playbook_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "fixture_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "profile_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "required": [
        "subject_format"
      ],
      "properties": {
        "required": {
          "const": true,
          "deprecated": true,
          "description": "Compatibility only. The sequential harness always creates one task commit."
        },
        "subject_format": {
          "type": "string",
          "minLength": 1,
          "description": "Python format string supporting {task_id} and {title}."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
