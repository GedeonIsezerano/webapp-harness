{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "retry_limits",
    "repository",
    "verification_profiles",
    "commit"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "retry_limits": {
      "type": "object",
      "required": [
        "verification",
        "browser",
        "review"
      ],
      "properties": {
        "verification": {
          "type": "integer",
          "minimum": 0
        },
        "browser": {
          "type": "integer",
          "minimum": 0
        },
        "review": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "allowed_dirty_paths"
      ],
      "properties": {
        "allowed_dirty_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "verification_profiles": {
      "type": "object"
    },
    "commit": {
      "type": "object",
      "required": [
        "required",
        "subject_format"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "subject_format": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
