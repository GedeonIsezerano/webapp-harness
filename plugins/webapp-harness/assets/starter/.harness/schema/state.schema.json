{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "active_task_id",
    "active_run_id",
    "last_completed_task_id",
    "last_completed_commit",
    "transition_history",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "active_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_completed_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_completed_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "transition_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "from",
          "to",
          "reason",
          "timestamp"
        ]
      }
    },
    "updated_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
