{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "status",
    "priority",
    "dependencies",
    "acceptance_criteria",
    "verification",
    "scope"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "gap_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "location",
          "observation"
        ],
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "proposed",
        "ready",
        "implementing",
        "verifying",
        "reviewing",
        "browser_validating",
        "completed",
        "blocked",
        "cancelled",
        "superseded"
      ]
    },
    "priority": {
      "type": "integer",
      "description": "Lower values run first; 1 is the highest priority."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "type": {
      "enum": [
        "user-facing",
        "backend",
        "infrastructure",
        "documentation"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "unit",
                "integration",
                "command",
                "build",
                "e2e",
                "browser",
                "visual",
                "manual-review"
              ]
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "profiles",
        "requires_browser"
      ],
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires_browser": {
          "type": "boolean"
        },
        "requires_e2e": {
          "type": "boolean",
          "deprecated": true,
          "description": "Compatibility only. E2E work is derived from acceptance-criterion verification kinds."
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "allowed_paths",
        "forbidden_paths"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "updated_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
